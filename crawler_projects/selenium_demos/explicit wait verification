from selenium import webdriver
from selenium.webdriver.chrome.service import Service
from selenium.webdriver.chrome.options import Options
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
import time


opt = Options()

service = Service(r"D:\py\chromedriver.exe")
driver = webdriver.Chrome(service=service, options=opt)

driver.get("https://www.sogou.com/")

# implicit wait     # until check if it is empty
WebDriverWait(driver, 15).until(EC.visibility_of_element_located((By.XPATH, '//*[@id="mokuai_1_13"]/div[2]/a[1]/img')))

# verify whether the elements in the backgrounds have been clicked
WebDriverWait(driver, 10).until(EC.element_to_be_clickable((By.ID, 'stb')))

# verification pop-up window
WebDriverWait(driver, 10).until(EC.alert_is_present())
# switching window
t = driver.switch_to.alert
# clicking acceptance
t.accept()


time.sleep(1)
print("Web Title: ", driver.title)
driver.save_screenshot("sogou.png")
time.sleep(1)


driver.maximize_window()
time.sleep(1)

url = driver.current_url
print(url)
time.sleep(1)

page = driver.page_source
print(page)
time.sleep(1)

box = driver.find_element(By.ID, "query")
time.sleep(1)
box.send_keys("Linus Torvalds")
time.sleep(1)
box.submit()
time.sleep(1)


driver.quit()
time.sleep(1)
